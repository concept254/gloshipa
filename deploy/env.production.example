# Glo Shipa: production settings for cPanel shared hosting (gloshipa.com)
#
# 1. Copy this file to  /home/CPANELUSER/gloshipa/.env   (the app folder, NOT public_html)
# 2. Replace every value marked CHANGE-ME
# 3. Create the app key on the server:  php artisan key:generate --force

APP_NAME="Glo Shipa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gloshipa.com
APP_TIMEZONE=Africa/Johannesburg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# cPanel > MySQL Database Wizard. cPanel adds your account name as a prefix to both names.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE-ME_gloshipa
DB_USERNAME=CHANGE-ME_gloshipa
DB_PASSWORD=CHANGE-ME

# Shared hosting has no queue worker, so keep these simple.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# cPanel > Email Accounts: create noreply@gloshipa.com and use its password here.
# Port 465 uses SSL (MAIL_SCHEME=smtps). If your host prefers 587, use MAIL_PORT=587 and MAIL_SCHEME=smtp.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.gloshipa.com
MAIL_PORT=465
MAIL_USERNAME=noreply@gloshipa.com
MAIL_PASSWORD=CHANGE-ME
MAIL_FROM_ADDRESS="noreply@gloshipa.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where "new registration waiting for approval" emails go, and the password for the
# "admin" login created by `php artisan db:seed --force`. Use a long, unique password
# and change it again after your first sign-in.
ADMIN_EMAIL=CHANGE-ME@gloshipa.com
ADMIN_PASSWORD=CHANGE-ME

# Shown in the website footer and at the bottom of every email.
COMPANY_EMAIL=support@gloshipa.com
COMPANY_PHONE="+27 00 000 0000"
COMPANY_ADDRESS="Johannesburg, South Africa"

VITE_APP_NAME="${APP_NAME}"
